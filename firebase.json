{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/posts", "destination": "/artigos/", "type": 301 },
      { "source": "/posts/", "destination": "/artigos/", "type": 301 },
      { "source": "/posts/:slug", "destination": "/artigos/:slug/", "type": 301 },
      { "source": "/posts/:slug/", "destination": "/artigos/:slug/", "type": 301 },
      { "source": "/cursos", "destination": "/ensino/", "type": 301 },
      { "source": "/cursos/", "destination": "/ensino/", "type": 301 },
      { "source": "/sobre", "destination": "/sobre/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff2|avif|webp|png|jpg|jpeg|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
